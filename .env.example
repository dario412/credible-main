# Database (Neon / Postgres)
DATABASE_URL=

# Auth (required in production)
AUTH_SECRET=
# Set to your public site URL, e.g. https://credible-main-lilac.vercel.app
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed script only
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Airtable roster sync (Personal Access Token — never commit real values)
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE="Credible | Data"

# Optional: protect POST /api/cron/sync-airtable-experts
CRON_SECRET=

# Optional: higher-quality logos from company websites during Airtable sync
# https://logo.dev — used when Organisations have URL but no Logo url / local wordmark.
# Without this token, brands without a Logo url or local asset are skipped
# (Google favicons were tried and render as white boxes on the dark hero).
# LOGO_DEV_TOKEN=

# Peptalk brief submissions (homepage + /contact). Defaults to production.
# PEPTALK_SUBMIT_URL=https://api.ops.getapeptalk.com/api/webflow/submit
