generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum LeadSource {
  WAITLIST
  CONTACT
}

enum LeadStatus {
  NEW
  READ
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(VIEWER)
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  createdBy    User?    @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]   @relation("UserCreatedBy")
}

model Expert {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  title          String
  bio            String
  shortBio       String?
  image          String?
  categories     String[]
  topics         String[]
  formats        String[] @default([])
  combinedReach  String?
  growth90d      String?
  audienceWho    String?
  audienceWhere  String?
  /// [{ "type": "linkedin"|"youtube"|"podcast"|"x", "url": "https://..." }]
  channels       Json     @default("[]")
  featured       Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CaseStudy {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  summary        String
  client         String   @default("")
  pillar         String   @default("Content")
  clientType     String   @default("Direct client")
  industry       String   @default("")
  size           String   @default("")
  period         String   @default("")
  coverImage     String?
  featured       Boolean  @default(false)
  /// Full CaseStudyCard extras: hero, meta, results, quote, story, ctaCreator, logo…
  data           Json     @default("{}")
  relatedExperts String[] @default([])
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Insight {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String
  /// Plain/markdown fallback + reading-time source
  body           String   @default("")
  /// Structured article blocks (p, h2, h3, quote, ul)
  blocks         Json?
  category       String   @default("Perspective")
  coverImage     String?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Lead {
  id        String     @id @default(cuid())
  email     String
  name      String?
  company   String?
  message   String?
  source    LeadSource
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
}

/// Singleton site settings (always id = "default").
model SiteSettings {
  id             String   @id @default("default")
  /// Display / heading font (font-display, prose headings)
  headingFamily  String   @default("Faculty Glyphic")
  headingSource  String   @default("default") // default | google | upload
  headingAssetId String?
  /// Body / paragraph font
  bodyFamily     String   @default("Instrument Sans")
  bodySource     String   @default("default") // default | google | upload
  bodyAssetId    String?
  updatedAt      DateTime @updatedAt
}

model FontAsset {
  id        String   @id @default(cuid())
  family    String
  fileName  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

/// Editable marketing page copy (home, about, what-we-do, …).
model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  sections  Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Shared “Trusted by” logos — reusable across marketing pages.
model TrustedClient {
  id               String   @id @default(cuid())
  name             String
  logoSrc          String   @default("")
  caseStudySlug    String   @default("")
  testimonialQuote String?
  testimonialName  String?
  testimonialTitle String?
  testimonialImage String?
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Uploaded media library (images) — served at /api/media/[id].
model MediaAsset {
  id        String   @id @default(cuid())
  fileName  String
  mimeType  String
  alt       String   @default("")
  byteSize  Int      @default(0)
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
